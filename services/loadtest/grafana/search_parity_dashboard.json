{
  "id": null,
  "uid": "stayvista-search-parity",
  "title": "StayVista Search Parity v1",
  "tags": ["stayvista", "search", "autocomplete", "calendar"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Autocomplete p95 (ms)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ac_latency_ms_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "ac_p95_ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Autocomplete Cache Hit Ratio",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ac_req_total{cache_hit=\\\"true\\\"}[5m])) / clamp_min(sum(rate(ac_req_total[5m])), 1)",
          "legendFormat": "cache_hit_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Price Calendar p95 (ms)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(price_calendar_latency_ms_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "pc_p95_ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Search p95 by Source (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(search_latency_ms_seconds_bucket[5m])) by (le, source)) * 1000",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Search Filter Usage (Top 10 / 15m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, sum(increase(search_filter_usage_total[15m])) by (filter))",
          "legendFormat": "{{filter}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Booking Funnel (15m)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(booking_funnel_stage_total{stage=\"hold\",result=\"SUCCESS\"}[15m]))",
          "legendFormat": "hold_success",
          "refId": "A"
        },
        {
          "expr": "sum(increase(booking_funnel_stage_total{stage=\"payment_authorized\",result=\"SUCCESS\"}[15m]))",
          "legendFormat": "payment_success",
          "refId": "B"
        },
        {
          "expr": "sum(increase(booking_funnel_stage_total{stage=\"confirm\",result=\"SUCCESS\"}[15m]))",
          "legendFormat": "confirm_success",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Auth Guard Reject by Path Group (15m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(increase(auth_guard_reject_total[15m])) by (path_group, reason)",
          "legendFormat": "{{path_group}}/{{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(auth_guard_reject_total{path_group=\"bookings\"}[15m]))",
          "legendFormat": "bookings_reject",
          "refId": "B"
        },
        {
          "expr": "sum(increase(auth_guard_reject_total{path_group=\"me\"}[15m]))",
          "legendFormat": "me_reject",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Booking Hold Drift Signals (15m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(increase(booking_hold_reused_total[15m]))",
          "legendFormat": "hold_reused",
          "refId": "A"
        },
        {
          "expr": "sum(increase(booking_hold_expired_released_total[15m]))",
          "legendFormat": "expired_hold_released",
          "refId": "B"
        },
        {
          "expr": "sum(increase(booking_overbooked_total{stage=\"hold\"}[15m]))",
          "legendFormat": "overbooked_hold",
          "refId": "C"
        },
        {
          "expr": "sum(increase(booking_overbooked_total{stage=\"confirm\"}[15m]))",
          "legendFormat": "overbooked_confirm",
          "refId": "D"
        }
      ]
    }
  ]
}
